# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key -- safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key. Bypasses Row Level Security -- server-only, never expose to the browser.
SUPABASE_SECRET_KEY=

# Supabase Storage bucket for uploaded images/publications (created by
# supabase/migrations/0001_init.sql as a public bucket). Optional -- defaults to
# 'lda-media' in code if unset.
SUPABASE_STORAGE_BUCKET=lda-media

# SMTP credentials for Q&A answer-notification emails (Nodemailer), port 587.
EMAIL_SERVER_HOST=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# Google OAuth is NOT configured here -- it's set up directly in the Supabase
# dashboard under Authentication -> Providers -> Google, with the authorized
# redirect URI: https://<your-project-ref>.supabase.co/auth/v1/callback
